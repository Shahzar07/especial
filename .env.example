# ── Required ────────────────────────────────────────────────────────────────
# Signs the gate cookie. Minimum 16 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATE_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# Enables ?preview=<token> to bypass the gate for QA and client demos.
# Leave unset to disable the bypass entirely.
PREVIEW_TOKEN=

# Canonical origin, used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://especialgallery.com

# Mailing list. One of: resend | klaviyo | mailchimp | none
# "none" logs the address and still admits the visitor, so the gate works
# end to end before an ESP is connected.
ESP_PROVIDER=none

RESEND_API_KEY=
RESEND_AUDIENCE_ID=

KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=

MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# Payment. Set this and checkout creates a real Stripe Checkout Session and
# redirects to it. Unset, orders are validated, priced and recorded, and the
# customer gets a confirmation — so the whole flow is testable before any
# Stripe account exists. Card details never reach this site either way.
STRIPE_SECRET_KEY=
